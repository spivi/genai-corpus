# --- Media, by extension: the corpus never enters git ---
# GitHub LFS free tier is ~1 GB against a 5 GB corpus cap. Real corpus media lives on
# Hugging Face. This list is the enforcement mechanism rather than a note in a README, so
# treat any addition to the real corpus's asset kinds as an addition here too.
# Images
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.tif
*.webp
*.svg
*.heic
*.psd
# Audio
*.mp3
*.wav
*.flac
*.ogg
*.m4a
*.aac
*.wma
# Video
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.m4v
# Model weights: never local disk in this series; Modal volumes only
*.pt
*.pth
*.safetensors
*.ckpt
*.bin
*.onnx
*.h5

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Notebooks ---
.ipynb_checkpoints/
# nbconvert output, written by the README's local command and by CI's notebook
# smoke test, and never the notebook source itself.
*.nbconvert.ipynb
executed_*.ipynb

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
